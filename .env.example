NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# Local Mongo. Replica set URI is preferred for multi-doc transactions:
# mongodb://127.0.0.1:27017/multiagent?replicaSet=rs0
# Standalone mongod still works; the app retries without a transaction.
# Later: paste your Atlas URL here.
MONGODB_URI=mongodb://127.0.0.1:27017/multiagent

APP_BASE_URL=http://localhost:3000
WORKER_SECRET=change-me
ENCRYPTION_KEY= # 64 hex characters (32 bytes)
ALLOW_TEST_AUTH=1
AGENT_PROVIDER=fake
FAKE_LEAD=default
FAKE_EVAL=pass
CEREBRAS_API_KEY=
SEARCH_API_KEY=
FIRECRAWL_API_KEY=
COINGECKO_API_KEY=
PRICES_API_KEY=
ALPHAVANTAGE_API_KEY=
EDGAR_UA=
# Optional. If set, delivered jobs email the memo.
RESEND_API_KEY=
MAIL_FROM=Multiagent <noreply@localhost>

# Optional. Box MCP OAuth from Admin Console → Custom Box MCP Server.
# Redirect URI: {APP_BASE_URL}/api/apps/oauth/callback
BOX_CLIENT_ID=
BOX_CLIENT_SECRET=

# Stock worker pool. Up to 10 desks, 10 concurrent jobs each.
# Overflow goes to the next configured desk; if every desk is full the job queues.
# Slot 1 also reads GROK_BOT_STOCKS_WEBHOOK_URL / KEY.
# GROK_BOT_STOCKS_WEBHOOK_URL=
# GROK_BOT_STOCKS_WEBHOOK_KEY=
# GROK_BOT_STOCKS_1_WEBHOOK_URL=
# GROK_BOT_STOCKS_1_WEBHOOK_KEY=
# GROK_BOT_STOCKS_2_WEBHOOK_URL=
# GROK_BOT_STOCKS_2_WEBHOOK_KEY=
# … through GROK_BOT_STOCKS_10_WEBHOOK_URL / KEY
# Optional fallback desk for non-stock jobs.
# GROK_BOT_WEBHOOK_URL=
# GROK_BOT_WEBHOOK_KEY=
# Public base for the callback (tunnel). Localhost is not reachable by the bot.
# GROK_BOT_CALLBACK_BASE=
