    "@dnd-kit/utilities": "^3.2.2",
    "@tanstack/react-table": "^9.2.4",
    "border-beam": "^1.4.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "echarts": "^6.1.0",
